{
  "name": "testmymcp",
  "version": "0.1.0",
  "description": "A protocol conformance + interoperability + robustness tester for MCP servers (Legacy + Modern eras, all transports).",
  "author": "SBTopZZZ-LG",
  "type": "module",
  "bin": {
    "testmymcp": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepare": "node ./scripts/prepare.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,css,md}": "prettier --write",
    "*.{ts,mjs}": "eslint --fix"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "conformance",
    "testing",
    "cli"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
